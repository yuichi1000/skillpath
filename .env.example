# ローカル開発用 (docker compose の Neo4j に接続)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localdevpassword
GOOGLE_CLOUD_PROJECT=skillpath-design
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_EXTRACT=gemini-3.5-flash
GCS_UPLOAD_BUCKET=skillpath-design-skillpath-uploads
GOOGLE_API_KEY=your-project-id-skillpath-uploads
GOOGLE_CLOUD_LOCATION=global
